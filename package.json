{
  "name": "mirra-ia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npx prisma generate",
    "dev": "rimraf .next && pnpm store prune && next dev",
    "build": "pnpm lint && next build",
    "start": "next start",
    "lint": "npx stylelint '**/*.{css,scss}' && next lint",
    "format": "pnpx stylelint '**/*.{css,scss}' --fix && prettier --write '**/*.{js,jsx,ts,tsx,json,md,scss,css}'",
    "prisma:init": "pnpx prisma init --datasource-provider mysql",
    "prisma:migrate": "pnpx prisma migrate dev",
    "prisma:generate": "pnpx prisma generate",
    "rok": "ngrok http http://127.0.0.1:3000"
  },
  "dependencies": {
    "@clerk/nextjs": "5.3.2",
    "@hookform/resolvers": "3.9.0",
    "@midudev/tailwind-animations": "0.1.0",
    "@prisma/client": "5.19.1",
    "@tanstack/react-query": "5.56.2",
    "axios": "1.7.5",
    "cloudinary": "2.4.0",
    "dayjs": "1.11.13",
    "lucide-react": "0.435.0",
    "next": "14.2.5",
    "next-cloudinary": "6.11.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-dropzone": "14.2.3",
    "react-hook-form": "7.53.0",
    "react-hot-toast": "2.4.1",
    "svix": "1.30.0",
    "usehooks-ts": "3.1.0",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "4.3.0",
    "@types/node": "22.7.4",
    "@types/react": "18.3.10",
    "@types/react-dom": "18.3.0",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.13",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-tailwindcss": "3.17.4",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "rimraf": "6.0.1",
    "sass": "1.79.3",
    "stylelint": "16.9.0",
    "stylelint-config-clean-order": "6.1.0",
    "stylelint-config-standard": "36.0.1",
    "stylelint-config-standard-scss": "13.1.0",
    "stylelint-config-two-dash-bem": "1.0.0",
    "tailwindcss": "3.4.13",
    "two-up-element": "1.0.1",
    "typescript": "5.6.2"
  }
}
